[Unit]
Description=Sonara Efí settlement scan
After=network-online.target sonara-efi.service
Wants=network-online.target

[Service]
Type=oneshot
User=sonara-efi
Group=sonara-efi
EnvironmentFile=/etc/sonara-efi/sonara-efi.env
WorkingDirectory=/opt/sonara-efi
ExecStart=/usr/bin/node /opt/sonara-efi/settlement.mjs
RuntimeMaxSec=55
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
