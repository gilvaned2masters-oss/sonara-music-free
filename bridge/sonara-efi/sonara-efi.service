[Unit]
Description=Sonara Music Efí Pix bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sonara-efi
Group=sonara-efi
EnvironmentFile=/etc/sonara-efi/sonara-efi.env
WorkingDirectory=/opt/sonara-efi
ExecStart=/usr/bin/node /opt/sonara-efi/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sonara-efi

[Install]
WantedBy=multi-user.target
