# Install at /etc/sonara-efi/sonara-efi.env with mode 0600. Do not commit values.
PORT=8081
SONARA_EFI_DB=/var/lib/sonara-efi/idempotency.sqlite
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
EFI_P12_PATH=/etc/sonara-efi/efi-production.p12
EFI_P12_PASSPHRASE=
EFI_BRIDGE_TOKEN=
# Token used only by the timer to call the authenticated Sonara Pages scanners.
SONARA_SETTLEMENT_URL=https://<sonara-pages-domain>/efi-settlement-scan
SONARA_PRODUCTION_SCAN_URL=https://<sonara-pages-domain>/production-scan
SONARA_SETTLEMENT_TOKEN=
